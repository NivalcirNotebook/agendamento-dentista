# Evolution API
EVOLUTION_API_URL=https://sua-evolution-api.com
EVOLUTION_API_KEY=sua-chave-api
EVOLUTION_INSTANCE_NAME=dentista-bot

# OpenAI
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4-turbo

# Google Calendar
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret
GOOGLE_CALENDAR_ID=primary
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
GOOGLE_REFRESH_TOKEN=

# Redis (EasyPanel)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Servidor
PORT=3000
NODE_ENV=development

# Configurações da Clínica
CLINIC_NAME=Clínica Odontológica
CLINIC_ADDRESS=Rua Exemplo, 123 - Centro
CLINIC_PHONE=+55 11 99999-9999
DENTIST_NAME=Dr. João Silva
CLINIC_BUSINESS_HOURS_START=08:00
CLINIC_BUSINESS_HOURS_END=18:00
CLINIC_APPOINTMENT_DURATION=30
# Dias de funcionamento (0=Domingo, 1=Segunda, 2=Terça, 3=Quarta, 4=Quinta, 5=Sexta, 6=Sábado)
# Exemplo: 1,2,3,4,5 = Segunda a Sexta | 1,2,3,4,5,6 = Segunda a Sábado
CLINIC_WORKING_DAYS=1,2,3,4,5
# Feriados (datas em que a clínica não atende)
# Aceita formato ISO (YYYY-MM-DD) ou brasileiro (DD/MM/YYYY)
# Exemplo ISO: 2026-01-01,2026-12-25,2026-04-21
# Exemplo BR: 01/01/2026,25/12/2026,21/04/2026
CLINIC_HOLIDAYS=

# Contexto Redis (TTL em segundos - 7 dias padrão)
CONTEXT_TTL=604800
