{
  "name": "dentista-bot-whatsapp",
  "version": "1.0.0",
  "description": "Bot de IA para agendamento de dentistas via WhatsApp",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "auth:google": "tsx src/scripts/google-auth.ts",
    "test:evolution": "tsx src/scripts/test-evolution.ts",
    "test:google": "tsx src/scripts/test-google-calendar.ts",
    "redis:clear": "tsx src/scripts/clear-redis.ts clear",
    "redis:list": "tsx src/scripts/clear-redis.ts list"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "dentista",
    "agendamento",
    "ia",
    "openai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "googleapis": "^129.0.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "openai": "^4.20.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.4",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "resolve-pkg-maps": "^1.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
